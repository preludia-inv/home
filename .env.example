# Public build-time settings. Never put secrets in VITE_* variables.
# International number, country code + number, digits only. No +, spaces or leading 0.
VITE_WHATSAPP_NUMBER=573136071110
# / for local or custom domain; /home/ for preludia-inv.github.io/home/.
VITE_BASE_PATH=/
# Full published URL, including the base path and trailing slash.
VITE_SITE_URL=https://preludia-inv.github.io/home/
# Optional future external, authenticated host portal. Leave empty for now.
VITE_PREMIUM_PORTAL_URL=
